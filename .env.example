# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Reuses the SAME Supabase project already set up for the marathon (1-2-MVP/product-mvp) —
# no new project needed, just a new table (see README "Supabase setup" below).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings -> API in Supabase. Only used server-side, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# YooKassa dashboard -> Settings -> Shop settings / API keys. Same shop as the marathon.
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# resend.com -> API Keys. Same account as the marathon's cohort-reminder email.
RESEND_API_KEY=your-resend-api-key
# Where "new payment, please add this person to GetCourse" notifications are sent.
NOTIFY_EMAIL=karolina_vikrovna@mail.ru
